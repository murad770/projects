# Copy this file to ".env" and fill in your real values.
# The real .env is gitignored so your credentials are never committed.

# --- Email delivery (required to actually send) ---
# Yahoo:  smtp.mail.yahoo.com   Gmail:  smtp.gmail.com
SMTP_HOST=smtp.mail.yahoo.com
# 465 = SSL, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=your-address@yahoo.com
# Use an APP PASSWORD, not your normal login password.
SMTP_PASS=your-app-password

# --- Recipient ---
MAIL_TO=murad404@yahoo.com
# Optional: defaults to SMTP_USER if omitted
# MAIL_FROM=your-address@yahoo.com

# --- Digest size (optional) ---
# PER_SOURCE=10
# TOTAL=10

# --- Daily HTML page location (optional) ---
# Where the daily run writes the HTML page. Set a fixed, bookmarkable path so
# the same file is refreshed every day. Missing folders are created for you.
# Defaults to digest.html in this folder if left unset.
# HTML_OUT=C:\Users\hmurad\news\today.html
